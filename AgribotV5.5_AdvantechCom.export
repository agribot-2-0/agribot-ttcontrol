                <Single Name="Id" Type="long">762</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">					IF ABS(GVL.Front_Cart_Rotation-Front_Cart_Setpoint)&gt;1 THEN	//front cart seeking setpoint is still active</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">831</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">						IF front_done = TRUE THEN //if last setpoint have been theoritically reached but we still havent reached the desired one, then set new one</Single>
              </Single>
