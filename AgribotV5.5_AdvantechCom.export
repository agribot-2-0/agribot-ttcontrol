                <Single Name="Text" Type="string">												liB500_types.IO_CAN_MODE.IO_CAN_MSG_WRITE,</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
