                <Single Name="Id" Type="long">508</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">			TX_Frame.id 		:=16#01;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">509</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">			TX_Frame.id_format	:=ADVANTECH_CAN_ID_FORMAT;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">510</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">			TX_Frame.length		:=1;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">511</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">			TX_Frame.data[0]	:=current_control_heartbeat_value;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">512</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">							</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">513</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">			bus_state:=lib500.IO_CAN_Status(GVL_Advantech.CAN_Advantech_CHANNEL, ADR(rx_error_counter), ADR(tx_error_counter));					</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">514</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">			lib500.IO_CAN_WriteMsg(	hWriteMsg,</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">515</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">									ADR(TX_Frame)); </Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">516</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">			write_error:=lib500.IO_CAN_MsgStatus(hWriteMsg);					</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">517</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">			WHILE ( write_error &lt;&gt; lib500_types.IO_ERRORTYPE.IO_E_OK) DO</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">518</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				write_error:=lib500.IO_CAN_MsgStatus(hWriteMsg);</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">519</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				//check if bus off or passive state</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">520</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				bus_state:=lib500.IO_CAN_Status(GVL_Advantech.CAN_Advantech_CHANNEL, ADR(rx_error_counter), ADR(tx_error_counter));</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">521</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				IF bus_state=lib500_types.IO_ERRORTYPE.IO_E_CAN_BUS_OFF OR bus_state=lib500_types.IO_ERRORTYPE.IO_E_CAN_ERROR_PASSIVE THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">529</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">					current_control_heartbeat_value:=1; //back to waiting status</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">530</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">					communication_state:=1; //lost connection with advantech</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">528</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">					TXHeartbeatTimer(IN:=FALSE, PT:=TXHeartbeatPeriod);</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">522</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">					EXIT;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">523</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				END_IF</Single>
              </Single>
