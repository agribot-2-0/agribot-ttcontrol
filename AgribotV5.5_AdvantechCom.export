                <Single Name="Text" Type="string">							front_rotation_setpoint := (current_front_rotation_setpoint/ticks_per_degree) - (front_rotation_speed*front_rotation_speed)/(2*front_rotation_deacceleration); //droga hamowania </Single>
              </Single>
