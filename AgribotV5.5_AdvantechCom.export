                <Single Name="Id" Type="long">1551</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">					RXManualControlTimer(IN:=TRUE, PT:=RXManualControlTimerPeriod);</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
