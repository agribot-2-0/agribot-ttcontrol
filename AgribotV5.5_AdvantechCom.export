                <Single Name="Id" Type="long">22</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">		IF 	translation_state_front = en_profilerState.FOLLOWING THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">23</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">			//sprawdz czy nie trzeba hamować 	</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">31</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">			IF	(ABS(REAL_TO_INT((front_translation_current_speed-front_translation_desired_end_speed)*(front_translation_current_speed+front_translation_desired_end_speed)/(2*Front_Track_TranslationDeacceleration)))&gt;=ABS((Front_Track_TranslationSetpoint-front_translation_current_setpoint))) </Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">698</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				AND ABS((Front_Track_TranslationSetpoint-front_translation_current_setpoint)) &lt;&gt;0 THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">74</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				IF front_translation_direction THEN</Single>
              </Single>
