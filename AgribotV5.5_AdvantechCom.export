              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">261</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">			GVL.manualControl.getMoveStraightCommand(ADR(dirFront), ADR(StraightSpeed), ADR(FrontCartActive), ADR(BackCartActive));</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">522</Single>
                <Null Name="Tag" />
