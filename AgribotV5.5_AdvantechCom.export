                <Single Name="Text" Type="string">			//to do:: create better name for this message, maybe an abrevations like "AIRFMMAFATPJ"</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">1053</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">			IF RX_Frame.udiCanID = en_canFrameID.CAN_ID_ManualOK THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">1054</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				IF (GVL.manualControl.getManualState() = en_manualModeState.WAIT_CONFIRMATION) THEN 	//check if agribot is ready and waiting</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">1055</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">					GVL.manualControl.setManualStatus(en_manualModeState.ACTIVE);						//received the manual control confirmation, manual control is active from that moment</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">1056</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">					status:=en_commStatus.MANUAL;														//activate reading of move commands</Single>
              </Single>
