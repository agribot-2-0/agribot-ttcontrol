                <Single Name="Id" Type="long">765</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">															16#0000);</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">766</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">			ELSE //if RX fifo is ready, create writing message object</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">767</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				io_error:=lib500.IO_CAN_ConfigMsg(ADR(hWriteMsg),</Single>
              </Single>
