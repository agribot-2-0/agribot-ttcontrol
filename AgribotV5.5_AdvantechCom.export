              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">952</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">			//if received a hearbeat, then reset the timer, if wrong number send error</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">953</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">			IF RX_Frame.udiCanID=en_canFrameID.CAN_ID_Heartbeat THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">954</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				IF hearbeat_counter=255 THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">955</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">					IF RX_Frame.barrData[0]=0 THEN		//if the last hearbeat has been on the egde (255-0)</Single>
              </Single>
