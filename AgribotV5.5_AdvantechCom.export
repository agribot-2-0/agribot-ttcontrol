                <Null Name="Tag" />
                <Single Name="Text" Type="string">	GVL_J1939.Valve_5_Command:=0;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
