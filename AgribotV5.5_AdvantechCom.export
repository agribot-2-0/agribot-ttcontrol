      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Array Name="TextLines" Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}">
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">10</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">IF GVL.manualControl.RPM_User_Request &lt;=100 THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">11</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">	EVL_J1939.RPMrequest:=REAL_TO_UINT((USINT_TO_REAL(GVL.manualControl.RPM_User_Request)/100)*(EVL_J1939.RPMMAX-EVL_J1939.RPMMIN)+EVL_J1939.RPMMIN);</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">12</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">ELSE //jesli brak recznego sterowania to automatyczne</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">13</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">	EVL_J1939.RPMDuty:=SINT_TO_REAL(ABS(GVL_J1939.Valve_0_Command))*0.005+SINT_TO_REAL(ABS(GVL_J1939.Valve_1_Command))*0.005+SINT_TO_REAL(ABS(GVL_J1939.Valve_2_Command))*0.005+SINT_TO_REAL(ABS(GVL_J1939.Valve_4_Command))*0.005;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">14</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">	EVL_J1939.RPMrequest:=EVL_J1939.RPMMIN+REAL_TO_UINT(UINT_TO_REAL(EVL_J1939.RPMMAX-EVL_J1939.RPMMIN)*EVL_J1939.RPMDuty);</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">15</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">	IF EVL_J1939.RPMrequest&gt;EVL_J1939.RPMMAX THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">16</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">		EVL_J1939.RPMrequest:=EVL_J1939.RPMMAX;	</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">17</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">	END_IF</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">9</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">END_IF</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">5</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">Engine_RPM_RAMP(IN:=EVL_J1939.RPMrequest-EVL_J1939.RPMMIN, ASCEND:=200, DESCEND:=200, TIMEBASE:=T#1S, RESET:=FALSE);</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">19</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">EVL_J1939.Engine_RPM_RAMP_OUT:=Engine_RPM_RAMP.OUT+UINT_TO_INT(EVL_J1939.RPMMIN); //write new rpm value</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">18</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">EVL_J1939.new_RPM_value_ready:=TRUE;</Single>
              </Single>
            </Array>
          </Single>
        </Single>
