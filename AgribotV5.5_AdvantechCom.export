              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">265</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">IF GVL.EngineIsReady=TRUE AND EVL_J1939.gValve_3_Timeout=FALSE AND GVL.ValvesInited=TRUE AND EVL_J1939.gJN2301_Timeout=FALSE THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">266</Single>
                <Null Name="Tag" />
