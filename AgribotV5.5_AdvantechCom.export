                <Single Name="Id" Type="long">756</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">		IF 	(io_error=lib500_types.IO_ERRORTYPE.IO_E_OK OR io_error=lib500_types.IO_ERRORTYPE.IO_E_CHANNEL_BUSY) THEN //check if can channel is ready</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">757</Single>
                <Null Name="Tag" />
