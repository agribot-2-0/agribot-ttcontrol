              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">762</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				io_error := GVL.BT_RXCanFramesFIFO.Create(GVL.CAN_BT_CHANNEL, </Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">763</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">															BT_CAN_ID_FORMAT,</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">764</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">															16#70,	</Single>
              </Single>
