                <Single Name="Text" Type="string">	//***********************************************************************************************</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">392</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">	//***********************************************************************************************</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">393</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">	//Receiving advantech messages</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">394</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">	WHILE GVL_Advantech.Advantech_RXCanFramesFIFO.uiAvailableFrames&lt;&gt;0 DO</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">395</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">		RX_Frame:=GVL_Advantech.Advantech_RXCanFramesFIFO.getFirstFrame();</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">397</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">		//check if advantech responded with control message</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">399</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">		IF RX_Frame.udiCanID = 16#01 THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">404</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">			//check if the message is fine</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">400</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">			IF RX_Frame.barrData[0] - current_control_heartbeat_value = 1 THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">402</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				current_control_heartbeat_value:=RX_Frame.barrData[0]+1; //inrease the received message by one</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">408</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				WaitForHearbeat:=FALSE; //send back the hearbeat</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">409</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				communication_state:=2; //advantech seems to be on the line and ready</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">436</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				//reset hearbeat timer</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">435</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				RXHeartbeatTimer(IN:=TRUE, PT:=TXHeartbeatPeriod);</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">437</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				RXHeartbeatTimer(IN:=FALSE, PT:=TXHeartbeatPeriod);</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
