                <Single Name="Text" Type="string">				GVL_Advantech.Desired_Right_Track_Back_Speed:=-WORD_TO_REAL(tempdata2b-SHL(16#01, 15))*speed_resolution;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">581</Single>
