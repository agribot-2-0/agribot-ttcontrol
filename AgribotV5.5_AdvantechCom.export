                <Null Name="Tag" />
                <Single Name="Text" Type="string">							front_translation_setpoint:=front_translation_setpoint - front_translation_speed; </Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
