                <Single Name="Text" Type="string">	</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">779</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">//*****************************************************//</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">780</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">//***********STATUS WAITING FOR HAND SHAKE*************//</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">781</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">//*****************************************************//</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">782</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">ELSIF status = en_commStatus.WAITING_FOR_HS THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">783</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">	//If there was connection loss, then exit manual mode:</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">784</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">	GVL.manualControl.setManualModeInactive();			//GVL.ManualControlState :=0;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">785</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">	//read fifo till the end</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">786</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">	WHILE GVL.BT_RXCanFramesFIFO.uiAvailableFrames&lt;&gt;0 DO</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">787</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">		RX_Frame:=GVL.BT_RXCanFramesFIFO.getFirstFrame();</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">788</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">		IF RX_Frame.udiCanID=0 THEN //something went wrong! need to deinit and back to status 0</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">789</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">			//deinit routine</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">790</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">			//.</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">791</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">			//.</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">792</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">			//.</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">793</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">			/////////</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">794</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">			status:=en_commStatus.INIT;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">795</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">		ELSE //check what we got</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">796</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">			IF RX_Frame.udiCanID = en_canFrameID.CAN_ID_RXHandShake THEN //if the message is a handshake initalization</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">797</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">798</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				//construct response frame to send</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">799</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				TX_Frame.id:=en_canFrameID.CAN_ID_TXHandShake;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">800</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				TX_Frame.id_format:=BT_CAN_ID_FORMAT;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">801</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				TX_Frame.length:=1;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">802</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				TX_Frame.data[0]:=1; //set the data for handshake //agribot ID</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">803</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				//send confirmation with agribots ID</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">1511</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">1516</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				bus_state:=lib500.IO_CAN_Status(GVL.CAN_BT_CHANNEL, ADR(rx_error_counter), ADR(tx_error_counter));					</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">1519</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				lib500.IO_CAN_WriteMsg(hWriteMsg,</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">1520</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">											ADR(TX_Frame)); </Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">1521</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				write_error:=lib500.IO_CAN_MsgStatus(hWriteMsg);					</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">1522</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				WHILE ( write_error &lt;&gt; lib500_types.IO_ERRORTYPE.IO_E_OK) DO</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">1523</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">					write_error:=lib500.IO_CAN_MsgStatus(hWriteMsg);</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
