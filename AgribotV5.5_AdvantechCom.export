                <Single Name="Text" Type="string">								</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">1546</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">					RXHeartbeatTimer(IN:=FALSE, PT:=RXHeartbeatTimerPeriod); //start heartbeat checking</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">1547</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">					RXHeartbeatTimer(IN:=TRUE, PT:=RXHeartbeatTimerPeriod); //start heartbeat checking</Single>
              </Single>
