                <Single Name="Text" Type="string"></Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">857</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				//send error message, connection lost, reason: lack of heartbeat, connection is unstable </Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">858</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				//construct the error frame to send</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">859</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				TX_Frame.id := en_canFrameID.CAN_ID_TXError;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">860</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				TX_Frame.id_format:=BT_CAN_ID_FORMAT;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">861</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				TX_Frame.length:=2;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">862</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				TX_Frame.data[0]:=16#00;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">863</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				TX_Frame.data[1]:=16#0F;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">1556</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">1560</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				bus_state:=lib500.IO_CAN_Status(GVL.CAN_BT_CHANNEL, ADR(rx_error_counter), ADR(tx_error_counter));					</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">1561</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				lib500.IO_CAN_WriteMsg(hWriteMsg,</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">1562</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">											ADR(TX_Frame)); </Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">1563</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				write_error:=lib500.IO_CAN_MsgStatus(hWriteMsg);					</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">1564</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				WHILE ( write_error &lt;&gt; lib500_types.IO_ERRORTYPE.IO_E_OK) DO</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">1565</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">					write_error:=lib500.IO_CAN_MsgStatus(hWriteMsg);</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">1566</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">					//check if bus off or passive state</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">1567</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">					bus_state:=lib500.IO_CAN_Status(GVL.CAN_BT_CHANNEL, ADR(rx_error_counter), ADR(tx_error_counter));</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">1568</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">					IF bus_state=lib500_types.IO_ERRORTYPE.IO_E_CAN_BUS_OFF OR bus_state=lib500_types.IO_ERRORTYPE.IO_E_CAN_ERROR_PASSIVE THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">1569</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">						EXIT;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">1570</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">					END_IF</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">1557</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				END_WHILE</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">873</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string"></Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">874</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">		ELSE 		//if heartbeat is healthy, then go on with routine</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">875</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">			RXHeartbeatTimer(IN:=TRUE, PT:=RXHeartbeatTimerPeriod); //keep on the heartbeat timer</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
