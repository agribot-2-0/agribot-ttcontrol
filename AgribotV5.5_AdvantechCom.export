                <Single Name="Id" Type="long">512</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">					IF ( ABS(current_front_translation_setpoint - front_translation_setpoint_ticks) &lt;= front_translation_speed_ticks*0.7 ) THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">515</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">						front_translation_end_speed:=front_translation_speed;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">640</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">						//shift the setpoint for another step of desired speed</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">516</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">						IF dirFront = TRUE THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">517</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">							front_translation_setpoint:=front_translation_setpoint + front_translation_speed; </Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">518</Single>
