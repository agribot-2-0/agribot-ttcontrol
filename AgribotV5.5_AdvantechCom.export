                <Null Name="Tag" />
                <Single Name="Text" Type="string">									</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">1298</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				io_error:=lib500.IO_CAN_ConfigMsg(ADR(hWriteMsg2),</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
