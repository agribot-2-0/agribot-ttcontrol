                <Null Name="Tag" />
                <Single Name="Text" Type="string">				front_translation_current_acceleration:=Front_Track_TranslationDeacceleration; //zmien wartosc przyspieszenia</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">33</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				translation_state_front:=en_profilerState.BRAKING; //musimy hamowac</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
