              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">83</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">					init := 3;  //set that the can channel has been inited</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">356</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">					communication_state:=1;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">863</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">					GVL_Advantech.Advantech_Channel_Ready:=TRUE;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">71</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">			END_IF</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">8</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">	END_IF</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">388</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string"></Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">357</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">	//check if advantech is ready and on the line</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">358</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">ELSIF communication_state = 1 THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">360</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">	//***********************************************************************************************</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">361</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">	//***********************************************************************************************</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">362</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">	//sending messages to advantech</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">363</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">	//heartbeat</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">364</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">	TXHeartbeatTimer(IN:=TRUE, PT:=T#5S);</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">365</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">	IF TXHeartbeatTimer.Q = TRUE THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">366</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">		//try to send heartbeat	</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">389</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">		current_control_heartbeat_value:=1;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">367</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">		TX_Frame.id 		:=16#01;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">368</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">		TX_Frame.id_format	:=ADVANTECH_CAN_ID_FORMAT;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">369</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">		TX_Frame.length		:=1;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">370</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">		TX_Frame.data[0]	:=current_control_heartbeat_value;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">371</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">					</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">372</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">		bus_state:=lib500.IO_CAN_Status(GVL_Advantech.CAN_Advantech_CHANNEL, ADR(rx_error_counter), ADR(tx_error_counter));	</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">496</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">		</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">373</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">		lib500.IO_CAN_WriteMsg(	hWriteMsg,</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">374</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">								ADR(TX_Frame)); </Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">375</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">		write_error:=lib500.IO_CAN_MsgStatus(hWriteMsg);					</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">376</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">		WHILE ( write_error &lt;&gt; lib500_types.IO_ERRORTYPE.IO_E_OK) DO</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">377</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">			write_error:=lib500.IO_CAN_MsgStatus(hWriteMsg);</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">378</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">			//check if bus off or passive state</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">379</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">			bus_state:=lib500.IO_CAN_Status(GVL_Advantech.CAN_Advantech_CHANNEL, ADR(rx_error_counter), ADR(tx_error_counter));</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">380</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">			IF bus_state=lib500_types.IO_ERRORTYPE.IO_E_CAN_BUS_OFF OR bus_state=lib500_types.IO_ERRORTYPE.IO_E_CAN_ERROR_PASSIVE THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">381</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				EXIT;</Single>
              </Single>
