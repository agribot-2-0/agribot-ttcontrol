                <Single Name="Id" Type="long">191</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">			IF(ABS(REAL_TO_INT((front_rotation_current_speed-front_rotation_desired_end_speed)*(front_rotation_current_speed+front_rotation_desired_end_speed)/(2*Front_Track_RotationDeacceleration)))&gt;=ABS((Front_Track_RotationSetpoint-front_rotation_current_setpoint))) </Single>
              </Single>
