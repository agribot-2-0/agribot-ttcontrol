                <Null Name="Tag" />
                <Single Name="Text" Type="string">		io_error := lib500.IO_CAN_Init(GVL.CAN_BT_CHANNEL,</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">751</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">							lib500_types.IO_CAN_BAUDRATE.IO_CAN_BIT_250_KB,</Single>
              </Single>
