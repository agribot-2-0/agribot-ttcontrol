                <Single Name="Text" Type="string">			// [MANUAL MODE CONNECTION STATE MACHINE 3]  Here, we receive reply from application for </Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">1052</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">			// AgribotIsRedyForManualModeAndFinishedAllThePendingJobs message      </Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
