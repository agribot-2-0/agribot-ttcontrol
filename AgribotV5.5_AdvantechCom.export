                <Single Name="Id" Type="long">853</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">	GVL_J1939.Valve_4_Command:=0; 										///back left track</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">854</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">	GVL_J1939.Valve_0_Command:=0; 										///back right track</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">855</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">	GVL_J1939.Valve_2_Command:=0; 										///front left track</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">852</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">	GVL_J1939.Valve_1_Command:=0; 										///front right track</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">456</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">//[MANUAL MODE: ]</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">37</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">//If Agribot is in Manual Mode</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">30</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">ELSE</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">31</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">	//[START AND STOP ENGINE ROUTINE]:</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">33</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">	IF GVL.manualControl.isEngneStartStopRequested() THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">107</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">		IF engineStarting THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">133</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				IF EVL_J1939.EngineEEC1.starterMode&gt;=4 THEN //wait till the engine is started</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">134</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">					GVL_IO.gSetEngineStarter:=FALSE;			</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">135</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">					GVL.EngineIsReady:=TRUE;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">136</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">					GVL.manualControl.clearRequestEngineStartStop();</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">140</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">					engineStarting:=FALSE;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">137</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				ELSE</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">138</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">					GVL_IO.gSetEngineStarter:=TRUE;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">139</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">					GVL.EngineIsReady:=FALSE;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">108</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				END_IF</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">110</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">		ELSE</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">113</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">			//IF engine is on, then we need to start stop engine procedure</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">114</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">			IF EVL_J1939.EngineEEC1.starterMode&lt;3 THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">115</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				//IF engine is off, then we need to start start engine procedure</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">116</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				//set engine ON</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">117</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				engineStarting:=TRUE;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">118</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				GVL_IO.gSetEngine:=TRUE;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">119</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				IF EVL_J1939.EngineEEC1.starterMode&gt;=4 THEN //wait till the engine is started</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">120</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">					GVL_IO.gSetEngineStarter:=FALSE;			</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">121</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">					GVL.EngineIsReady:=TRUE;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">122</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">					GVL.manualControl.clearRequestEngineStartStop();</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">123</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				ELSE</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">124</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">					GVL_IO.gSetEngineStarter:=TRUE;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">125</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">					GVL.EngineIsReady:=FALSE;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">126</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				END_IF</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">127</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">			ELSE</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">128</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">129</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				GVL_IO.gSetEngine:=FALSE;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">130</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				GVL_IO.gSetEngineStarter:=FALSE;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">131</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				GVL.EngineIsReady:=FALSE;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">132</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				GVL.manualControl.clearRequestEngineStartStop();</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">111</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">			END_IF	</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">109</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">		END_IF</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">67</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">		</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">38</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">	END_IF</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">61</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">	</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">377</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">	//[MANUAL COMMANDS ROUTINE: ]</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">457</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">	//check if engines and valves are working</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">63</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">	IF GVL.EngineIsReady AND GVL.ValvesInited AND EVL_J1939.gValve_0_Timeout=FALSE AND EVL_J1939.gValve_1_Timeout=FALSE AND EVL_J1939.gValve_2_Timeout=FALSE AND EVL_J1939.gValve_4_Timeout=FALSE THEN </Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">378</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">		//[MANUAL SET SWITCHES: ]</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">144</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">		//check and set switches</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">145</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">		switch_iterator:=1;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">151</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">		WHILE switch_iterator&lt;=12 DO</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">152</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">			GVL.manualControl.checkSwitchDemand(switch_iterator, ADR(switch_state), ADR(switch_level));</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">179</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">			//check what switch we are currently checking</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">180</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">			IF switch_iterator = 7 THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">185</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				//set PTO TYŁ</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">186</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				IF switch_state = TRUE THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">187</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">					GVL_J1939.Valve_8_Command:=USINT_TO_SINT(switch_level);</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">188</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">					//GVL.Valve_8_Command:=0;	</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">189</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				ELSE</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">190</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">					GVL_J1939.Valve_8_Command:=0;	</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">191</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				END_IF</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">192</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">			ELSIF  switch_iterator = 11 THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">194</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				//set tuz TYŁ DÓŁ</Single>
              </Single>
