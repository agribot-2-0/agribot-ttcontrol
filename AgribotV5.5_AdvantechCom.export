                <Single Name="Id" Type="long">1120</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">			IF  RX_Frame.udiCanID=en_canFrameID.CAN_ID_AgribotStatus1 THEN //en_canFrameID.CAN_ID_AgribotStatus1 is also dataRequest</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
