                <Single Name="Id" Type="long">153</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">	TX_Frame.data[2]	:=TO_BYTE(error.device_num);</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">149</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">	TX_Frame.data[3]	:=TO_BYTE(error.error_code);</Single>
              </Single>
