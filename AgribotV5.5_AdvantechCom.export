                <Single Name="Id" Type="long">1283</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				IF EVL_J1939.EngineEEC1.speedRPM &gt; 16#FFF0 THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">1310</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">					TX_Frame.data[0]:=16#00;//dataPointer^[2];//[2]												//uint, predkosc obrotowa w RPM</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">1311</Single>
                <Null Name="Tag" />
