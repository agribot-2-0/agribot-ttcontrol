                <Single Name="Id" Type="long">1541</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				IF write_error=lib500_types.IO_ERRORTYPE.IO_E_OK THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">1544</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">					GVL.DeviceConnected:=TRUE; //device connected flag set</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
