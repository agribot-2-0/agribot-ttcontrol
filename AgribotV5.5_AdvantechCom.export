                <Null Name="Tag" />
                <Single Name="Text" Type="string">			//sprawdz czy nie trzeba hamować 	</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">310</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">			IF(ABS(REAL_TO_INT((back_translation_current_speed-back_translation_desired_end_speed)*(back_translation_current_speed+back_translation_desired_end_speed)/(2*Back_Track_TranslationDeacceleration)))&gt;=ABS((Back_Track_TranslationSetpoint-back_translation_current_setpoint))) THEN</Single>
