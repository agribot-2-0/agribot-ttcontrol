                <Single Name="Text" Type="string">		</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">634</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">		//reset timer</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">631</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">		TXSpeedDataTimer(IN:=FALSE, PT:=T#100MS);</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">633</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">		TXSpeedDataTimer(IN:=TRUE, PT:=T#100MS);</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">630</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">	END_IF</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">624</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">	</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">625</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">	</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">623</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">	</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">412</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">	//***********************************************************************************************</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">413</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">	//***********************************************************************************************</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">414</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">	//Receiving advantech messages</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">415</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">	WHILE GVL_Advantech.Advantech_RXCanFramesFIFO.uiAvailableFrames &lt;&gt; 0 DO</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">416</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">		RX_Frame:=GVL_Advantech.Advantech_RXCanFramesFIFO.getFirstFrame();</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">417</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">		//check if advantech responded with control message</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">426</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">		IF 	WaitForHearbeat = TRUE THEN //if we need to send back the hearbeat or are waiting on the next one</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">439</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">			RXHeartbeatTimer(IN:=TRUE, PT:=RECEIVE_TIMEOUT_PERIOD);</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">442</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">			IF RXHeartbeatTimer.Q = FALSE THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">445</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				IF RX_Frame.udiCanID = 16#01 THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">446</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">					//check if the message is fine</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">484</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">					IF RX_Frame.barrData[0] &lt;&gt; 0 THEN //check if the counter looped back</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">447</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">						IF RX_Frame.barrData[0] - current_control_heartbeat_value = 1 THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">448</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">							current_control_heartbeat_value:=RX_Frame.barrData[0]+1; //inrease the received message by one</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">489</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">							IF current_control_heartbeat_value =128 THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">490</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">								current_control_heartbeat_value:=0;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">491</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">							END_IF</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">458</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">							WaitForHearbeat:=FALSE; //now we need to send our own message</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">488</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">							RXHeartbeatTimer(IN:=FALSE, PT:=RECEIVE_TIMEOUT_PERIOD);</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">450</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">						END_IF</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">486</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">					ELSE //check if the last control message weve send was 127</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">487</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">						IF current_control_heartbeat_value = 127 THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">492</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">							current_control_heartbeat_value:=1; //send </Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">494</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">							WaitForHearbeat:=FALSE; //now we need to send our own message</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">495</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">							RXHeartbeatTimer(IN:=FALSE, PT:=RECEIVE_TIMEOUT_PERIOD);</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">493</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">						END_IF</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">485</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">					END_IF</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">443</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				END_IF</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">451</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">			ELSE</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">480</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				current_control_heartbeat_value:=1; //back to waiting status</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">453</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				communication_state:=1; //lost connection with advantech</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">452</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				RXHeartbeatTimer(IN:=FALSE, PT:=RECEIVE_TIMEOUT_PERIOD);</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">444</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">			END_IF</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">550</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">		END_IF</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">548</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">		IF RX_Frame.udiCanID = 16#0A THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">589</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">			//front left</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">562</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">			tempdata2b:=(SHL(BYTE_TO_WORD(RX_Frame.barrData[0]), 8)+RX_Frame.barrData[1]);	</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">557</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">			IF SHR(tempdata2b, 15) = 0 THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">560</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				GVL_Advantech.Desired_Left_Track_Front_Speed:=(WORD_TO_REAL(tempdata2b)*speed_resolution);</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">564</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">			ELSE</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">565</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				GVL_Advantech.Desired_Left_Track_Front_Speed:=-WORD_TO_REAL(tempdata2b-SHL(16#01, 15))*speed_resolution;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">559</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">			END_IF</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">572</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">			//front right</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">571</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">			tempdata2b:=(SHL(BYTE_TO_WORD(RX_Frame.barrData[2]), 8)+RX_Frame.barrData[3]);</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">567</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">			IF SHR(tempdata2b, 15) = 0 THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">568</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				GVL_Advantech.Desired_Right_Track_Front_Speed:=(WORD_TO_REAL(tempdata2b)*speed_resolution); </Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">569</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">			ELSE</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">570</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				GVL_Advantech.Desired_Right_Track_Front_Speed:=-WORD_TO_REAL(tempdata2b-SHL(16#01, 15))*speed_resolution;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">566</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">			END_IF</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">573</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">			//back left</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">574</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">			tempdata2b:=(SHL(BYTE_TO_WORD(RX_Frame.barrData[4]), 8)+RX_Frame.barrData[5]);</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">576</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">			IF SHR(tempdata2b, 15) = 0 THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">577</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				GVL_Advantech.Desired_Left_Track_Back_Speed:=(WORD_TO_REAL(tempdata2b)*speed_resolution);</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">578</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">			ELSE</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">579</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				GVL_Advantech.Desired_Left_Track_Back_Speed:=-WORD_TO_REAL(tempdata2b-SHL(16#01, 15))*speed_resolution;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">575</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">			END_IF</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">580</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">			//back right</Single>
              </Single>
