                <Single Name="Id" Type="long">9</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">	FrontCartSpeedSum:=		Speed_Front_Left + Speed_Front_Right;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">17</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">	BackCartSpeedSum:= 		Speed_Back_Left + Speed_Back_Right;</Single>
              </Single>
