                <Single Name="Id" Type="long">1252</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				tempdata:=REAL_TO_UINT(EVL_J1939.EngineEEC1.speedRPM);</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">1288</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				tempdata_union.dwordData:=REAL_TO_DWORD(EVL_J1939.EngineEEC1.speedRPM);</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">1124</Single>
