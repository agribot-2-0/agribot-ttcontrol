                <Single Name="Id" Type="long">699</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				AND ABS((Front_Track_RotationSetpoint-front_rotation_current_setpoint))&lt;&gt;0 THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">192</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				IF front_rotation_direction THEN</Single>
