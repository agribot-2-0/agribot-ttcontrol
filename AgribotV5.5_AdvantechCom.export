                <Null Name="Tag" />
                <Single Name="Text" Type="string">				IF (back_translation_current_setpoint &gt;= Back_Track_TranslationSetpoint) OR (translation_state_back = en_profilerState.BRAKING AND back_translation_current_speed = 0) THEN</Single>
