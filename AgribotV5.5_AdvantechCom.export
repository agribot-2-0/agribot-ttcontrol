                <Single Name="Text" Type="string">				END_IF</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">141</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">			ELSE // jesli setpoint leżał za nami, to znaczy że dopóki dalej jest za nami to wir mussen kontineeren</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">142</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				//jesli jestesmy w lub za setpointem, to stop</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">143</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				IF (front_translation_current_setpoint &lt;= Front_Track_TranslationSetpoint) OR (translation_state_front = en_profilerState.BRAKING AND front_translation_current_speed = 0) THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
