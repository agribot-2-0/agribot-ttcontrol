                <Null Name="Tag" />
                <Single Name="Text" Type="string">					TX_Frame.data[0]:=tempdata_union.arrayData[2];//dataPointer^[2];//[2]												//uint, predkosc obrotowa w RPM</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
