                <Single Name="Text" Type="string">			GVL.manualControl.getMoveSetCartsRotation(ADR(FrontCartActive), ADR(Front_Cart_Setpoint), ADR(BackCartActive), ADR(Back_Cart_Setpoint));</Single>
              </Single>
