                <Single Name="Text" Type="string">			EngineOnOff(IN:=TRUE, PT:=EngineOnOffTimerPeriod);</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">2064</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">			</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">2065</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">			IF RX_Frame.udiCanID = en_canFrameID.CAN_ID_CommandStartEngine THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">2066</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				IF EngineOnOff.ET &lt;= TIME#1200MS THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">2067</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">					GVL.manualControl.requestEngineStartStop();</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">2068</Single>
                <Null Name="Tag" />
