                <Null Name="Tag" />
                <Single Name="Text" Type="string">				TX_Frame.data[2]:=INT_TO_USINT(EVL_J1939.EngineEEC1.actualPercentTorque);			 //integer, torque in percents of max torque</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">1128</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				TX_Frame.data[3]:=REAL_TO_USINT(EVL_J1939.EngineFuelRate.fuelRate*10);  			//engine fuel rate</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">1129</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				TX_Frame.data[4]:=REAL_TO_USINT(WORD_TO_REAL(EVL_J1939.gE2700_FuelData.FuelLevelLitres*100)/105.0);						//fuel level</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
