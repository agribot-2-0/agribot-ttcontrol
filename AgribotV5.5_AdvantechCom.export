              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">878</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">		//if in manual mode, check if the button timeout had occured		</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">879</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">		//++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">880</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">		//IF status=en_commStatus.MANUAL THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">881</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">			IF RXManualControlTimer.Q THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">882</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				GVL.manualControl.clearMoveCommands(TRUE);</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">883</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">			ELSE</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">884</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">				RXManualControlTimer(IN:=TRUE, PT:=RXManualControlTimerPeriod);</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">885</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">			END_IF</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">886</Single>
