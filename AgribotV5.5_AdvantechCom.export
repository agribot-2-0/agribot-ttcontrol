                <Null Name="Tag" />
                <Single Name="Text" Type="string">						bus_state:=lib500.IO_CAN_Status(GVL.CAN_BT_CHANNEL, ADR(rx_error_counter), ADR(tx_error_counter));					</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
